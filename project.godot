[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Enemy"
3d_physics/layer_4="PlayerHitbox"
3d_physics/layer_5="EnemyHitbox"
3d_physics/layer_6="Pickup"
3d_physics/layer_7="Projectile"
3d_navigation/layer_1="Walkable"

[physics]

3d/default_gravity=20.0

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.07, 0.08, 0.10, 1)
